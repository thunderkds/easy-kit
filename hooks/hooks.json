{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "grep -qsF '$CLAUDE_PROJECT_DIR\\\"/.claude/hooks/post_write_register_task.py' \"$CLAUDE_PROJECT_DIR/.claude/settings.json\" || python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/post_write_register_task.py\""
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "grep -qsF '$CLAUDE_PROJECT_DIR\\\"/.claude/hooks/post_agent_move_to_review.py' \"$CLAUDE_PROJECT_DIR/.claude/settings.json\" || python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/post_agent_move_to_review.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "grep -qsF '$CLAUDE_PROJECT_DIR\\\"/.claude/hooks/post_bash_memory_update.py' \"$CLAUDE_PROJECT_DIR/.claude/settings.json\" || python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/post_bash_memory_update.py\""
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "grep -qsF '$CLAUDE_PROJECT_DIR\\\"/.claude/hooks/post_tool_trace.py' \"$CLAUDE_PROJECT_DIR/.claude/settings.json\" || python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/post_tool_trace.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "grep -qsF '$CLAUDE_PROJECT_DIR\\\"/.claude/hooks/pre_agent_validate_guide.py' \"$CLAUDE_PROJECT_DIR/.claude/settings.json\" || python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/pre_agent_validate_guide.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "grep -qsF '$CLAUDE_PROJECT_DIR\\\"/.claude/hooks/pre_bash_block_unsafe_merge.py' \"$CLAUDE_PROJECT_DIR/.claude/settings.json\" || python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/pre_bash_block_unsafe_merge.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "grep -qsF '$CLAUDE_PROJECT_DIR\\\"/.claude/hooks/pre_tool_sensitive_path.py' \"$CLAUDE_PROJECT_DIR/.claude/settings.json\" || python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/pre_tool_sensitive_path.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "grep -qsF '$CLAUDE_PROJECT_DIR\\\"/.claude/hooks/pre_tool_locked_oracle.py' \"$CLAUDE_PROJECT_DIR/.claude/settings.json\" || python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/pre_tool_locked_oracle.py\""
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "grep -qsF '$CLAUDE_PROJECT_DIR\\\"/.claude/hooks/pre_agent_step_limit.py' \"$CLAUDE_PROJECT_DIR/.claude/settings.json\" || python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/pre_agent_step_limit.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "grep -qsF '$CLAUDE_PROJECT_DIR\\\"/.claude/hooks/stop_review_reminder.py' \"$CLAUDE_PROJECT_DIR/.claude/settings.json\" || python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/stop_review_reminder.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "grep -qsF '$CLAUDE_PROJECT_DIR\\\"/.claude/hooks/stop_auto_mode_check.py' \"$CLAUDE_PROJECT_DIR/.claude/settings.json\" || python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/stop_auto_mode_check.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "grep -qsF '$CLAUDE_PROJECT_DIR\\\"/.claude/hooks/stop_auto_verify.py' \"$CLAUDE_PROJECT_DIR/.claude/settings.json\" || python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/stop_auto_verify.py\""
          }
        ]
      }
    ]
  }
}
